        <mxCell id="c71" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#37474f;color:#fff;padding:4px 6px;border:1px solid #999;text-align:left;width:50px;&quot;&gt;Paso&lt;/th&gt;&lt;th style=&quot;background:#37474f;color:#fff;padding:4px 6px;border:1px solid #999;text-align:left;width:330px;&quot;&gt;Qué se envía&lt;/th&gt;&lt;th style=&quot;background:#37474f;color:#fff;padding:4px 6px;border:1px solid #999;text-align:left;width:140px;&quot;&gt;Quién pone SDA&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;START&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Maestro (FPGA)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fa&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;1010 000 + W (0xA0)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Maestro; ACK de la EEPROM&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Dirección interna alta (A15–A8)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Maestro; ACK&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fa&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Dirección interna baja (A7–A0)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Maestro; ACK&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Hasta 64 bytes de datos&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Maestro; ACK por byte&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fa&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;STOP → la EEPROM graba ≈ 5 ms&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Maestro&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Leer&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;START, 0xA0, dir. alta, dir. baja, START repetido, 0xA1, datos (ACK… NACK en el último), STOP&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;La EEPROM pone los datos&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;spacing=6;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1040" y="420" width="520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c72" value="&lt;b style=&quot;font-size:14px&quot;&gt;SPI frente a I2C&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#37474f;color:#fff;padding:4px 6px;border:1px solid #999;text-align:left;width:170px;&quot;&gt;&lt;/th&gt;&lt;th style=&quot;background:#37474f;color:#fff;padding:4px 6px;border:1px solid #999;text-align:left;width:300px;&quot;&gt;SPI&lt;/th&gt;&lt;th style=&quot;background:#37474f;color:#fff;padding:4px 6px;border:1px solid #999;text-align:left;width:300px;&quot;&gt;I2C&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Hilos&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;4 (SCK, MOSI, MISO, CS) + 1 CS por dispositivo&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;2 (SCL, SDA) compartidos por todos&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fa&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Quién elige al dispositivo&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;La línea CS&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Una dirección de 7 bits en el primer byte&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Confirmación&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Ninguna&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;ACK en cada byte&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fa&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Velocidad usada&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;12,5 MHz&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;100 kHz&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Salidas&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Push-pull&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Open-drain + pull-ups&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fa&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;En la consola&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;SPI-RAM y Flash (rápidas, mucho dato)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;EEPROM (poco dato, no volátil)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;spacing=6;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="940" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
