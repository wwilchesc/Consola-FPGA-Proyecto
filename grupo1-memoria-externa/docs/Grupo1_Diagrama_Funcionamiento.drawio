        <mxCell id="c43" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#37474f;color:#fff;padding:4px 6px;border:1px solid #999;text-align:left;width:150px;&quot;&gt;Comando&lt;/th&gt;&lt;th style=&quot;background:#37474f;color:#fff;padding:4px 6px;border:1px solid #999;text-align:left;width:130px;&quot;&gt;Memoria&lt;/th&gt;&lt;th style=&quot;background:#37474f;color:#fff;padding:4px 6px;border:1px solid #999;text-align:left;width:170px;&quot;&gt;Bytes que siguen&lt;/th&gt;&lt;th style=&quot;background:#37474f;color:#fff;padding:4px 6px;border:1px solid #999;text-align:left;width:320px;&quot;&gt;Para qué&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;0x03 READ&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;SPI-RAM y Flash&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;dirección 3 B, luego datos&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Leer (secuencial: la dirección avanza sola)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fa&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;0x02 WRITE / PROGRAM&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;SPI-RAM / Flash&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;dirección 3 B + datos&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Escribir (Flash: máx. 256 B por página, antes WREN)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;0x9F JEDEC ID&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Flash&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;3 B de respuesta&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Saber si la Flash responde (autotest)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fa&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;0x06 WREN&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Flash&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Habilitar escritura&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;0x20 SECTOR ERASE&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Flash&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;dirección 3 B&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Borrar 4 KB (queda en 0xFF)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f8fa&quot;&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;0x05 RDSR&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Flash&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;1 B de estado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border:1px solid #bbb;vertical-align:top;&quot;&gt;Bit 0 WIP = 1 mientras borra o programa&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;spacing=6;fontSize=12;fontFamily=Helvetica;" ve