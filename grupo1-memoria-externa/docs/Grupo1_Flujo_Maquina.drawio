        <mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;fontColor=#1a5276;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;fontColor=#1a5276;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;fontColor=#1a5276;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;b style=&quot;font-size:14px&quot;&gt;b) Un comando del motor I2C (perip_i2c)&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="200" width="440" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="La CPU escribe CONTROL&lt;br&gt;con un comando" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="888" y="240" width="193" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="¿Qué comando?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="890" y="324" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="START: SDA baja con SCL&lt;br&gt;en alto; luego SCL baja" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1125" y="334" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="STOP: SDA sube con SCL&lt;br&gt;en alto" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1358" y="334" width="173" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="WRITE: 8 bits de&lt;br&gt;TX_DATA, MSB primero;&lt;br&gt;SDA solo cambia con SCL&lt;br&gt;en bajo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="895" y="428" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="Noveno pulso: soltar SDA&lt;br&gt;y leer ACK_IN (0 = ACK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
