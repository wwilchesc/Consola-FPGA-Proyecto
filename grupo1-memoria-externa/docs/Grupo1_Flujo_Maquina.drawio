        <mxCell id="c76" value="&lt;b&gt;Leyenda&lt;/b&gt;: paralelogramo = lectura/escritura en una memoria externa · borde punteado = lo hace el hardware solo · rombo = decisión.&lt;br&gt;Cada lectura o escritura usa los controladores de la página 2: la CPU escribe la orden y espera BUSY = 0." style="rounded=1;arcSize=3;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;spacing=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="960" y="1180" width="560" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pag1" name="Controladores SPI e I2C (HW)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1033" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3" value="&lt;b style=&quot;font-size:24px&quot;&gt;M3. Flujos de hardware: motor SPI y motor I2C&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#555&quot;&gt;Máquinas de estado dentro de los controladores, con el reloj de 50 MHz.&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;table style=&quot;font-size:11px;width:100%&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;border-right:1px solid #ccc&quot;&gt;&lt;b&gt;Responsable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#e1d5e7;border:1px solid #9673a6;padding:0 4px;border-radius:3px;white-space:nowrap&quot;&gt;Grupo 1 · Memoria externa&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;border-right:1px solid #ccc&quot;&gt;&lt;b&gt;Prioridad&lt;/b&gt;&lt;br&gt;5&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;border-right:1px solid #ccc&quot;&gt;&lt;b&gt;Se dispara con&lt;/b&gt;&lt;br&gt;Escritura de CONTROL con START (SPI) o con un comando (I2C)&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;border-right:1px solid #ccc&quot;&gt;&lt;b&gt;HW / SW&lt;/b&gt;&lt;br&gt;HW&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;border-right:1px solid #ccc&quot;&gt;&lt;b&gt;Sincronización&lt;/b&gt;&lt;br&gt;BUSY = 1 durante la transacción; la CPU sondea&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;border-right:1px solid #ccc&quot;&gt;&lt;b&gt;Entradas&lt;/b&gt;&lt;br&gt;CONTROL, ADDR, WDATA / TX_DATA, CLK_DIV&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;border-right:1px solid #ccc&quot;&gt;&lt;b&gt;Salidas&lt;/b&gt;&lt;br&gt;SCK, MOSI, CS / SCL, SDA; RDATA / RX_DATA, DONE, ACK_IN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b style=&quot;font-size:14px&quot;&gt;a) Transacción SPI modo 0 (perip_spi)&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="440" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="La CPU escribe CONTROL con&lt;br&gt;START" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="75" y="240" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="BUSY = 1; CS = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="118" y="324" width="134" height="35" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="Desplazar comando de 8 bits,&lt;br&gt;MSB primero: MOSI cambia con&lt;br&gt;SCK en 0, la memoria lee en&lt;br&gt;el flanco de subida" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="79" y="393" width="213" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="¿El comando lleva&lt;br&gt;dirección? (0x03,&lt;br&gt;0x02, 0x20)" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="75" y="507" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Desplazar dirección de 24&lt;br&gt;bits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="378" y="542" width="193" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="¿Lectura o&lt;br&gt;escritura?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="90" y="662" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="Desplazar WDATA (8 bits)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="382" y="806" width="186" height="35" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="Leer MISO en cada flanco de&lt;br&gt;subida → RDATA (8 bits, 24&lt;br&gt;para 0x9F)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="82" y="790" width="206" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="CS = 1; BUSY = 0; DONE = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="85" y="890" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="Reposo (SCK = 0, CS = 1)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="82" y="958" width="206" height="35" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;fontColor=#1a5276;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7">
          <mxGeometry relative="1" as="geometry" />
