        <mxCell id="c11" value="Presiona volver" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="242" y="605" width="127" height="35" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="Elige un juego y juega" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="508" y="605" width="173" height="35" as="geometry" />
