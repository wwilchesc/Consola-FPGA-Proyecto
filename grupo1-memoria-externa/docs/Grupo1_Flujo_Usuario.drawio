        <mxCell id="c9" value="¿Quiere ver los&lt;br&gt;récords?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="495" y="476" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Ve el top 5 de cada juego, con&lt;br&gt;las iniciales de partidas de&lt;br&gt;otros días" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
