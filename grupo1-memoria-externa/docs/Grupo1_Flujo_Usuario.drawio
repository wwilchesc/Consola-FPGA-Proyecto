  <diagram id="pag0" name="Vista del usuario">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1544" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3" value="&lt;b style=&quot;font-size:24px&quot;&gt;Grupo 1 · Memoria externa — Diagrama de flujo desde el punto de vista del usuario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#555&quot;&gt;Qué vive el jugador gracias a la memoria externa: gráficos que cargan al encender y récords que no se borran al apagar. Sin tecnología.&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Enciende la consola" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="508" y="110" width="173" height="35" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Ve el logo y una barra&lt;br&gt;«Cargando…» (menos de 1 s)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="495" y="179" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="¿La consola encontró&lt;br&gt;todo bien?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="470" y="263" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Ve un aviso corto: «Récords no&lt;br&gt;disponibles» o «Menú sin&lt;br&gt;gráficos»; puede jugar igual" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="772" y="278" width="226" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="Ve el menú con el logo y los&lt;br&gt;gráficos" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
